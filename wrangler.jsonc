// Cloudflare Worker config for aijan-web. Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aijan-web",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  // Better Auth uses a few Node APIs (AsyncLocalStorage).
  "compatibility_flags": ["nodejs_compat"],
  "build": { "command": "node scripts/build.mjs" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /sessions/foo serves dist/sessions/foo.html, and /guide serves dist/guide.html
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // These reach the Worker code; everything else is served straight from dist/. /mcp is the admin MCP (src/mcp.js).
    // Sessions live in D1, so their pages, share images, the browser's session list, the sitemap and llms.txt
    // are drawn on request (src/site.js; keep this list the same as ROUTES there).
    "run_worker_first": ["/api/*", "/assets/sessions.js", "/sessions/*", "/faculty/*", "/og/sessions/*", "/sitemap.xml", "/llms.txt", "/mcp"]
  },
  // Page templates, the map points and the logo come in as text, and the fonts as bytes, for src/site.js and scripts/og.mjs.
  "rules": [
    { "type": "Text", "globs": ["**/*.html", "**/*.svg", "**/nola-points.js"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }
  ],
  // Users, sign-in sessions, taps, and the sessions themselves. Tables are in migrations/. Preview links share this database.
  "d1_databases": [
    { "binding": "DB", "database_name": "aijan-db", "database_id": "8dd790c4-6e28-422b-8ca0-d0f281df4858", "migrations_dir": "migrations" }
  ],
  // Beignet answers @mentions in Slack from a Durable Object, one per Slack event (src/slack-bot.js, docs/slack.md).
  "durable_objects": { "bindings": [{ "name": "SLACK_BOT", "class_name": "SlackBot" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SlackBot"] }],
  // How many email-first taps (POST /api/start) one visitor can make in a minute. Each one makes an account, sends an email
  // and posts in Slack. Counted per IP address, so it is high enough for a room on one Wi-Fi. See docs/auth.md.
  "ratelimits": [{ "name": "START_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
  // Not secret. Secrets (BETTER_AUTH_SECRET, GOOGLE_*, APPLE_*, RESEND_API_KEY, SLACK_BOT_TOKEN, SLACK_SIGNING_SECRET, OPENROUTER_API_KEY) are set in the Cloudflare dashboard. See docs/auth.md.
  "vars": {
    // Sign-in emails come from this address. Its domain must be verified in Resend.
    "EMAIL_FROM": "AI January <hello@joinaijanuary.com>",
    // The private #ai-january-inbox channel in the AI Friday Slack. See docs/slack.md.
    "SLACK_CHANNEL": "C0CF1Q9AMBK",
    // The one channel where @Beignet answers and can use the admin tools. Mentions anywhere else are ignored.
    "SLACK_ADMIN_CHANNEL": "C0CF1Q9AMBK",
    // The model Beignet uses, as an OpenRouter id (https://openrouter.ai/models). Any model that supports tools works.
    "BOT_MODEL": "anthropic/claude-sonnet-5.5"
  },
  "observability": { "enabled": true }
}
